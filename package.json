{
  "name": "create-tauri-app-nuxt",
  "description": "Create application using Tauri with Nuxt",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tauri build",
    "dev": "tauri-nuxt-dev",
    "postinstall": "pnpm nuxt:postinstall",
    "typecheck": "pnpm nuxt:typecheck",
    "fmt": "run-p oxc:fmt cargo:fmt",
    "lint": "run-p oxc:lint cargo:lint",
    "check": "run-p oxc:check cargo:check",
    "validate": "run-s fmt lint check typecheck",
    "oxc:fmt": "oxfmt",
    "oxc:check": "oxfmt --check",
    "oxc:lint": "oxlint",
    "cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "cargo:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "cargo:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "cargo:clean": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "cargo:clean:release": "cargo clean --release --manifest-path src-tauri/Cargo.toml",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "nuxt:build": "nuxt build",
    "nuxt:dev": "nuxt dev",
    "nuxt:generate": "nuxt generate",
    "nuxt:preview": "nuxt preview",
    "nuxt:postinstall": "nuxt prepare",
    "nuxt:typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "nuxt": "^4.5.2",
    "valibot": "^1.5.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@golar/vue": "^0.1.10",
    "@nuxt/cli": "4.0.0-alpha.1",
    "@oxlint/plugins": "^1.85.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "golar": "^0.1.10",
    "lefthook": "^2.1.14",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-plugin-vize": "^0.428.1",
    "oxlint-tsgolint": "^7.0.2003",
    "tauri-nuxt-dev": "^0.0.1",
    "typescript": "^6.0.3"
  }
}
