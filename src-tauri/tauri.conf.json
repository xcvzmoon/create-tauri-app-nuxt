{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "create-tauri-app-nuxt",
  "version": "0.0.0",
  "identifier": "com.create-tauri-app-nuxt.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:65432",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm nuxt:generate"
  },
  "app": {
    "windows": [
      {
        "title": "create-tauri-app-nuxt",
        "width": 750,
        "height": 475,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/Applications/**",
          "/System/Applications/**",
          "/System/Library/CoreServices/**",
          "$HOME/Applications/**",
          "$HOME/Library/Caches/com.create-tauri-app-nuxt.dev/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
